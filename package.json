{
  "name": "agentik",
  "version": "0.3.3",
  "description": "Kogn: agente personal de escritorio para macOS",
  "license": "MIT",
  "author": "Daniel Pineda",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "build:ts": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "dev": "npm run build:ts && electron .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run build:ts && electron-builder --mac dmg",
    "predev": "electron-rebuild -f -w better-sqlite3",
    "pretest": "npm rebuild better-sqlite3"
  },
  "build": {
    "appId": "com.agetik.app",
    "productName": "Kogn",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/*.dmg",
      "!dist/*.blockmap",
      "!dist/.temp*",
      "!dist/mac*/**",
      "!dist/builder-*",
      "config.json",
      "package.json"
    ],
    "mac": {
      "identity": "-",
      "hardenedRuntime": false,
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "LSUIElement": true
      }
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/papaparse": "^5.5.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
